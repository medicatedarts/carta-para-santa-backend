{
  "name": "carta-para-santa-backend",
  "version": "1.0.0",
  "description": "Backend de CartaParaSanta.com: recibe la carta, cobra con Stripe y manda a Lob a imprimir y enviar la respuesta de Santa.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
