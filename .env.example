# Copia este archivo a ".env" y llena los valores. Nunca subas el ".env" real a git.

# --- Servidor ---
PORT=4000
# URL pública del backend (Lob descarga de aquí las fuentes e imágenes de la carta)
BACKEND_PUBLIC_URL=http://localhost:4000
# URL del sitio (redirecciones de Stripe y CORS)
FRONTEND_URL=http://localhost:5500
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5500,https://www.cartaparasanta.com

# --- Base de datos (Postgres de Render) ---
DATABASE_URL=postgres://usuario:clave@localhost:5432/cartaparasanta

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Precio en centavos. El valor real se puede cambiar luego desde el panel (tabla settings).
LETTER_PRICE_CENTS=0
STRIPE_CURRENCY=usd
# "included" = el IVU va incluido en el precio (como en Yo Te Lo Dije); "added" = se suma aparte
TAX_MODE=included

# --- Lob ---
# Usa la test key mientras desarrollas: genera el PDF sin imprimir ni cobrar
LOB_API_KEY=
LOB_WEBHOOK_SECRET=
# Remitente: dirección creada en el dashboard de Lob (nombre: Santa Claus)
LOB_FROM_ADDRESS_ID=
# Opción B si no usas un address ID
LOB_FROM_NAME=Santa Claus
LOB_FROM_ADDRESS_LINE1=
LOB_FROM_ADDRESS_LINE2=
LOB_FROM_ADDRESS_CITY=
LOB_FROM_ADDRESS_STATE=
LOB_FROM_ADDRESS_ZIP=
LOB_FROM_ADDRESS_COUNTRY=US
LOB_USE_TYPE=operational
# Verificar la dirección con USPS antes de cobrar: auto (solo con clave live) | on | off
ADDRESS_VERIFICATION=auto

# --- Correo transaccional ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Remitente: una dirección del subdominio verificado en Resend (solo envía)
EMAIL_FROM="Taller de Santa <santa@polonorte.cartaparasanta.com>"
# A dónde llegan las respuestas de los padres (dirección que sí recibe correo)
EMAIL_REPLY_TO=hola@cartaparasanta.com
# A dónde llegan las alertas de órdenes con error o en revisión
ALERT_EMAIL=

# --- Administración ---
ADMIN_TOKEN=
# Clave para firmar las URL desde donde Lob descarga cada carta (si se deja vacía se usa ADMIN_TOKEN)
PRINT_URL_SECRET=

# --- Temporada ---
# Fecha límite recomendada y cierre del buzón (también se pueden cambiar desde el panel)
DEADLINE_RECOMMENDED=2026-12-10
MAILBOX_CLOSE_DATE=2026-12-14
# Días después de la entrega en que se borra el contenido de la carta y la dirección
RETENTION_DAYS_AFTER_DELIVERY=45

# --- Filtro de contenido ---
# Términos extra a bloquear, separados por coma (fuera del código fuente)
CUSTOM_BLOCKED_TERMS=
